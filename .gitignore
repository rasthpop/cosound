# Secrets
.env
.env.*
!.env.example
!frontend/.env.mock

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.import_linter_cache/

# Local databases
*.db
*.sqlite
*.sqlite3

# Data: raw/derived data stays local; evaluation inputs are tracked
# FMA archives and audio (fma_small is ~7.2 GiB) are never committed.
data/raw/fma/
*.zip
*.zip.part
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/embeddings/*
!data/embeddings/.gitkeep
data/indexes/*
!data/indexes/.gitkeep
data/llm_cache/
data/models/

# Generated artifacts
artifacts/**
!artifacts/*/
!artifacts/*/.gitkeep

# Audio, model checkpoints, arrays
*.mp3
*.wav
*.flac
*.ogg
*.pt
*.ckpt
*.npy
*.npz
*.bin
*.safetensors

# Node
node_modules/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/

# Editors / OS
.idea/
.vscode/
.DS_Store
