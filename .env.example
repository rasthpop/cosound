APP_ENV=development
DATABASE_URL=sqlite:///./music_discovery.db

DISCOGS_USER_AGENT=SemanticMusicDiscovery/0.1
DISCOGS_TOKEN=

# ADR-0002. Fetch with: uv run python scripts/fetch_clap_model.py
CLAP_CHECKPOINT=./data/models/larger_clap_music_and_speech
CLAP_MODEL_VERSION=laion/larger_clap_music_and_speech@195c3a3e68faebb3e2088b9a79e79b43ddbda76b

DATA_DIR=./data
ARTIFACTS_DIR=./artifacts

UMAP_RANDOM_STATE=42
UMAP_N_COMPONENTS=2

ACTIVE_EMBEDDING_VERSION=
ACTIVE_PROJECTION_VERSION=

# Optional agent LLMs: OpenRouter free models (https://openrouter.ai/collections/free-models).
# Leave LLM_PROVIDER empty to disable every LLM path (deterministic fallbacks are used).
LLM_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
# Optional per-task primaries; each falls back to LLM_MODEL.
LLM_MODEL_QUERY=
LLM_MODEL_FEEDBACK=
LLM_MODEL_DESCRIPTIONS=
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
OPENROUTER_APP_TITLE=SemanticMusicDiscovery
OPENROUTER_HTTP_REFERER=

API_CORS_ORIGINS=http://localhost:5173
